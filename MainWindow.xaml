<Window x:Class="RadminStreamApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadminStreamApp"
        Title="Radmin Stream Live" Height="550" Width="900" MinHeight="420" MinWidth="620"
        Background="#0F0F13"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="app_icon.ico">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D35"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Close Button Style -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D35"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0094F2" Offset="0.0"/>
                        <GradientStop Color="#005A9E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0094F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#CC2929"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E53939"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- System Colors Override for Dark Mode (Fixes ComboBox dropdown and other popups) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E24" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E1E24" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        
        <!-- ComboBox Basic Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <!-- Video Control Button Style -->
        <Style x:Key="VideoControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock Text="Radmin Stream Live" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnSettingsModal_Click" ToolTip="Configurações"/>
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click"/>
                <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Update Banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#CC2929" Margin="15,10,15,0" CornerRadius="8" Padding="10,5" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="UpdateBannerText" Text="Uma nova versão está disponível!" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnUpdate" Content="Atualizar Agora" Style="{StaticResource ModernButton}" Background="#1E1E24" Margin="0,0,10,0" Padding="10,2" Click="BtnUpdate_Click"/>
                    <Button x:Name="BtnDismissUpdate" Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDismissUpdate_Click" ToolTip="Ignorar por enquanto" Margin="0,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Panel (Controls) -->
        <Border x:Name="TopPanel" Grid.Row="2" Margin="15,10,15,15" Background="#18181E" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
            </Border.Effect>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Margin="0,3,20,3">
                    <Button x:Name="BtnHost" Content="Transmitir" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="BtnHost_Click"/>
                    <Button x:Name="BtnViewer" Content="Assistir" Style="{StaticResource ModernButton}" Click="BtnViewer_Click"/>
                </StackPanel>

                <Border Width="1" Background="#2D2D35" Margin="0,3,20,3" VerticalAlignment="Stretch"/>

                <!-- Controles do Host -->
                <StackPanel x:Name="PanelHost" Orientation="Horizontal" Visibility="Collapsed" Margin="0,3,0,3">
                    <TextBlock Text="Tela:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboWindows" Width="150" Margin="0,0,10,0" DisplayMemberPath="Title"
                              VerticalAlignment="Center" Height="30"
                              DropDownOpened="CboWindows_DropDownOpened" SelectionChanged="CboWindows_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#1E1E24"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button x:Name="BtnStartStream" Content="Start" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BtnStartStream_Click"/>
                    <Button x:Name="BtnStopStream" Content="Stop" Style="{StaticResource DangerButton}" IsEnabled="False" Click="BtnStopStream_Click"/>
                    <StackPanel x:Name="ViewerCountPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                Background="Transparent" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#0094F2" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="ViewerCountText" Text="0 Viewers" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Controles do modo Assistir -->
                <StackPanel x:Name="PanelViewer" Orientation="Horizontal" Visibility="Collapsed" Margin="0,3,0,3">
                    <ToggleButton x:Name="ToggleTabsView" Width="96" Height="30" Margin="0,0,10,0" Cursor="Hand"
                                  Background="#2D2D35" Foreground="#EEEEEE" BorderThickness="0"
                                  Checked="ToggleTabsView_Changed" Unchecked="ToggleTabsView_Changed"
                                  ToolTip="Alternar entre grade e abas">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock x:Name="TxtLayoutMode" Text="Grade" FontSize="12" FontWeight="SemiBold"/>
                    </ToggleButton>

                    <Button x:Name="BtnQuality" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                            Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Style="{StaticResource ModernButton}" Click="BtnQuality_Click" ToolTip="Qualidade do vídeo">
                        <Button.ContextMenu>
                            <ContextMenu Background="#1E1E24" Foreground="White" BorderBrush="#3D3D45">
                                <MenuItem Header="1080p (Alta)" Click="MenuItemQuality_Click" Tag="1080p"/>
                                <MenuItem Header="720p (Média)" Click="MenuItemQuality_Click" Tag="720p"/>
                                <MenuItem Header="480p (Leve)" Click="MenuItemQuality_Click" Tag="480p"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnPip" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                            Content="PiP" FontSize="11" FontWeight="Bold"
                            Style="{StaticResource ModernButton}" Click="BtnPip_Click" ToolTip="Picture-in-Picture"/>
                    <Button x:Name="BtnTheater" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                            Content="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Style="{StaticResource ModernButton}" Click="BtnTheater_Click" ToolTip="Modo teatro"/>
                    <Button x:Name="BtnFullscreen" Width="34" Height="30" Padding="0"
                            Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Style="{StaticResource ModernButton}" Click="BtnFullscreen_Click" ToolTip="Tela cheia"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Preview local do Host -->
        <Border x:Name="VideoBorder" Grid.Row="3" Background="#050508" Margin="15,0,15,15" CornerRadius="12" ClipToBounds="True" BorderBrush="#2D2D35" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.6" ShadowDepth="5"/>
            </Border.Effect>
            <Grid>
                <StackPanel x:Name="HostEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="No Signal" Foreground="#222222" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusHint" Text="Escolha uma tela e clique em Start" Foreground="#3A3A42" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
                <Image x:Name="VideoPlayer" Stretch="Uniform" MouseDown="VideoPlayer_MouseDown"/>

                <Border x:Name="StatsOverlay" Background="#99000000" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="StatsText" Text="" Foreground="White" FontSize="11" FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>

        <!-- Modo Assistir: sidebar de amigos + uma ou mais lives -->
        <Grid x:Name="ViewerArea" Grid.Row="3" Margin="15,0,15,15" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Área das lives -->
            <Grid Grid.Column="1">
                <Border Background="#050508" CornerRadius="12" BorderBrush="#2D2D35" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <StackPanel x:Name="ViewerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#2A2A32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ViewerEmptyText" Text="Clique em um amigo à esquerda para assistir"
                                       Foreground="#555560" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="GridSessions">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:StreamTab OnCloseRequested="StreamTab_OnCloseRequested"
                                                     OnActivated="StreamTab_OnActivated"
                                                     OnFullscreenRequested="StreamTab_OnFullscreenRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TabControl x:Name="TabSessions" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                    SelectionChanged="TabSessions_SelectionChanged">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Background" Value="#18181E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#00D26A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FriendName}" Padding="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <local:StreamTab OnCloseRequested="StreamTab_OnCloseRequested"
                                                     OnActivated="StreamTab_OnActivated"
                                                     OnFullscreenRequested="StreamTab_OnFullscreenRequested"/>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sidebar de amigos -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="#18181E" CornerRadius="8" Margin="0,0,10,0"
                    BorderBrush="#2D2D35" BorderThickness="1" Panel.ZIndex="10" MouseLeave="SidebarPanel_MouseLeave">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AMIGOS" Foreground="#666670" FontSize="11" FontWeight="Bold" Margin="4,0,0,8"/>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LstFriendsSidebar">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E24" CornerRadius="6" Margin="0,0,0,6" Padding="8,7"
                                                Cursor="Hand" BorderThickness="1" BorderBrush="Transparent"
                                                MouseLeftButtonUp="FriendCard_Click" ToolTip="{Binding StatusTooltip}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                            <Setter Property="Background" Value="#16324A"/>
                                                            <Setter Property="BorderBrush" Value="#0094F2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" Fill="{Binding StatusColor}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SubtitleText}" Foreground="#8A8A94" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE768;"/>
                                                            <Setter Property="Foreground" Value="#0094F2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE71A;"/>
                                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Text" Value=""/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="SidebarEmptyState" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Nenhum amigo adicionado ainda" Foreground="#666670" FontSize="12"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="4,0,4,10"/>
                            <Button Content="Adicionar amigo" Style="{StaticResource ModernButton}"
                                    Padding="8,6" FontSize="12" Click="BtnManageFriends_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="SidebarNoneOnline" Text="Nenhum amigo online no momento"
                                   Foreground="#666670" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Bottom" Margin="4,8,4,0" Visibility="Collapsed"/>
                    </Grid>

                    <Button Grid.Row="2" x:Name="BtnManageFriends" Content="Gerenciar amigos"
                            FontSize="12" Padding="8,6" Margin="0,8,0,0"
                            Style="{StaticResource ModernButton}" Click="BtnManageFriends_Click"/>
                </Grid>
            </Border>

            <!-- Faixa invisível que traz a sidebar de volta quando ela se esconde -->
            <Border x:Name="SidebarHoverStrip" Grid.Column="0" Grid.ColumnSpan="2" Width="40" HorizontalAlignment="Left"
                    Margin="-15,0,0,0" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="9"
                    MouseEnter="SidebarHoverStrip_MouseEnter">
                <Border Width="4" Height="48" CornerRadius="2" Background="#332D2D35" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="17,0,0,0" IsHitTestVisible="False"/>
            </Border>
        </Grid>

        <!-- Floating Overlay for Mouse Activity -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="4" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
        </Grid>

        <!-- Settings Modal Overlay -->
        <Grid x:Name="SettingsModalOverlay" Grid.RowSpan="4" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#18181E" Width="450" Height="300" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="20,20,20,10">
                        <TextBlock Text="Configurações" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Foreground="#AAAAAA" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand" Click="BtnCloseSettingsModal_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                    <!-- Tabs -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0,10,10">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Name="Border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,0" Padding="5,5,5,10" Cursor="Hand">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#0094F2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        
                        <!-- Settings Tab -->
                        <TabItem Header="Settings" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="10,20,10,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkMaxPerformance" Content="Modo de Desempenho Máximo (Menos uso de CPU)" Foreground="White" FontSize="14" IsChecked="True" Checked="ChkMaxPerformance_Changed" Unchecked="ChkMaxPerformance_Changed"/>
                                    <TextBlock Text="Ativar esta opção diminui a prioridade do aplicativo para garantir que seus jogos rodem com mais FPS, além de otimizar os cálculos da transmissão." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="20,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        
                        <!-- Info Tab -->
                        <TabItem Header="Info" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="10,20,10,10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Radmin Stream Live" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Versão 1.0.14" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                                    
                                    <TextBlock Foreground="#0094F2" FontSize="14" HorizontalAlignment="Center" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="GithubLink_Click">
                                        GitHub Repository
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
