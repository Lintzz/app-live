<Window x:Class="RadminStreamApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radmin Stream Live" Height="550" Width="900"
        Background="#0F0F13"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="app_icon.ico">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D35"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Close Button Style -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D35"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0094F2" Offset="0.0"/>
                        <GradientStop Color="#005A9E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0094F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#CC2929"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E53939"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- System Colors Override for Dark Mode (Fixes ComboBox dropdown and other popups) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E24" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E1E24" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        
        <!-- ComboBox Basic Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <!-- Video Control Button Style -->
        <Style x:Key="VideoControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock Text="Radmin Stream Live" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnSettingsModal_Click" ToolTip="Configurações"/>
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click"/>
                <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Update Banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#CC2929" Margin="15,10,15,0" CornerRadius="8" Padding="10,5" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="UpdateBannerText" Text="Uma nova versão está disponível!" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnUpdate" Content="Atualizar Agora" Style="{StaticResource ModernButton}" Background="#1E1E24" Margin="0,0,10,0" Padding="10,2" Click="BtnUpdate_Click"/>
                    <Button x:Name="BtnDismissUpdate" Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDismissUpdate_Click" ToolTip="Ignorar por enquanto" Margin="0,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Panel (Controls) -->
        <Border x:Name="TopPanel" Grid.Row="2" Margin="15,10,15,15" Background="#18181E" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Button x:Name="BtnHost" Content="Host Stream" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="BtnHost_Click"/>
                    <Button x:Name="BtnClient" Content="Join Stream" Style="{StaticResource ModernButton}" Click="BtnClient_Click"/>
                </StackPanel>
                
                <Border Width="1" Background="#2D2D35" Margin="0,0,20,0" VerticalAlignment="Stretch"/>
                
                <!-- Host Controls -->
                <StackPanel x:Name="PanelHost" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="CboWindows" Width="200" Margin="0,0,10,0" DisplayMemberPath="Title" VerticalAlignment="Center" Height="30" DropDownOpened="CboWindows_DropDownOpened">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#1E1E24"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button x:Name="BtnStartStream" Content="Start" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BtnStartStream_Click"/>
                    <Button x:Name="BtnStopStream" Content="Stop" Style="{StaticResource DangerButton}" IsEnabled="False" Click="BtnStopStream_Click"/>
                    <StackPanel x:Name="ViewerCountPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" Foreground="#AAAAAA" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="ViewerCountText" Text="0 Viewers" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Client Controls -->
                <StackPanel x:Name="PanelClient" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Host IP:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtHostIp" Style="{StaticResource ModernTextBox}" Width="110" Height="30" Margin="0,0,10,0" Text="127.0.0.1"/>
                    <Button x:Name="BtnConnect" Content="Connect" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BtnConnect_Click"/>
                    <Button x:Name="BtnDisconnect" Content="Disconnect" Style="{StaticResource DangerButton}" IsEnabled="False" Margin="0,0,10,0" Click="BtnDisconnect_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Video Player -->
        <Border x:Name="VideoBorder" Grid.Row="3" Background="#050508" Margin="15,0,15,15" CornerRadius="12" ClipToBounds="True" BorderBrush="#2D2D35" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.6" ShadowDepth="5"/>
            </Border.Effect>
            <Grid>
                <TextBlock x:Name="StatusText" Text="No Signal" Foreground="#222222" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="VideoPlayer" Stretch="Uniform" MouseDown="VideoPlayer_MouseDown"/>
                
                <StackPanel x:Name="VideoControlsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                    <TextBlock x:Name="IconVolume" Visibility="Collapsed" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#66FFFFFF" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider x:Name="SliderVolume" Visibility="Collapsed" Width="80" Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" Margin="0,0,15,0" ValueChanged="SliderVolume_ValueChanged"/>
                    
                    <Button x:Name="BtnSettings" Visibility="Collapsed" Style="{StaticResource VideoControlButton}" ToolTip="Qualidade do Vídeo" Click="BtnSettings_Click">
                        <Button.ContextMenu>
                            <ContextMenu Background="#1E1E24" Foreground="White" BorderBrush="#3D3D45">
                                <MenuItem Header="1080p (Alta)" Click="MenuItemQuality_Click" Tag="1080p"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                            <Border x:Name="BadgeHD" Background="#E50000" CornerRadius="2" Margin="2,0,0,0" Padding="2,0" VerticalAlignment="Center" Height="14">
                                <TextBlock x:Name="TextHD" Text="HD" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTheater" Visibility="Collapsed" Style="{StaticResource VideoControlButton}" Content="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" ToolTip="Modo Teatro" Click="BtnTheater_Click" Margin="10,0,0,0"/>
                    <Button x:Name="BtnFullscreen" Visibility="Collapsed" Style="{StaticResource VideoControlButton}" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="18" ToolTip="Tela Cheia" Click="BtnFullscreen_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating Overlay for Mouse Activity -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="4" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
        </Grid>

        <!-- Settings Modal Overlay -->
        <Grid x:Name="SettingsModalOverlay" Grid.RowSpan="4" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#18181E" Width="450" Height="300" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="20,20,20,10">
                        <TextBlock Text="Configurações" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Foreground="#AAAAAA" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand" Click="BtnCloseSettingsModal_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                    <!-- Tabs -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0,10,10">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Name="Border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,0" Padding="5,5,5,10" Cursor="Hand">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#0094F2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        
                        <!-- Settings Tab -->
                        <TabItem Header="Settings" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="10,20,10,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkMaxPerformance" Content="Modo de Desempenho Máximo (Menos uso de CPU)" Foreground="White" FontSize="14" IsChecked="True" Checked="ChkMaxPerformance_Changed" Unchecked="ChkMaxPerformance_Changed"/>
                                    <TextBlock Text="Ativar esta opção diminui a prioridade do aplicativo para garantir que seus jogos rodem com mais FPS, além de otimizar os cálculos da transmissão." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="20,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        
                        <!-- Info Tab -->
                        <TabItem Header="Info" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="10,20,10,10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Radmin Stream Live" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Versão 1.0.6" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                                    
                                    <TextBlock Foreground="#0094F2" FontSize="14" HorizontalAlignment="Center" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="GithubLink_Click">
                                        GitHub Repository
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
