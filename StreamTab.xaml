<UserControl x:Class="RadminStreamApp.StreamTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="120" MinWidth="160"
             MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <UserControl.Resources>
        <Style x:Key="TabIconButton" TargetType="Button">
            <Setter Property="Background" Value="#99000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC3D3D45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="#050508" CornerRadius="8" ClipToBounds="True"
            BorderBrush="#2D2D35" BorderThickness="1" Margin="4">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="#0094F2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Image Source="{Binding VideoBitmap}" Stretch="Uniform"/>

            <Border Background="#88000000" CornerRadius="4" Padding="6,2" Margin="8"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{Binding FriendName}" Foreground="White" FontWeight="Bold" FontSize="12"/>
            </Border>

            <TextBlock Text="{Binding StatusText}" Foreground="#CCCCCC" FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="260" TextAlignment="Center"/>

            <Border Background="#99000000" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Margin="8">
                <TextBlock Text="{Binding StatsText}" Foreground="White" FontSize="10" FontFamily="Consolas"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                <Button Content="{Binding MuteIcon}" Style="{StaticResource TabIconButton}" Margin="0,0,6,0"
                        Click="BtnMute_Click" ToolTip="Mudo"/>
                <Slider Width="60" Minimum="0" Maximum="200" Value="{Binding Volume, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Volume"/>
                <Button Content="&#xE711;" Style="{StaticResource TabIconButton}" Background="#CC2929"
                        Click="BtnClose_Click" ToolTip="Sair desta live"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
