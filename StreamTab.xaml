<UserControl x:Class="RadminStreamApp.StreamTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="120" MinWidth="160">
    <Border Background="#050508" CornerRadius="8" ClipToBounds="True" BorderBrush="#2D2D35" BorderThickness="1" Margin="4">
        <Grid>
            <Image Source="{Binding VideoBitmap}" Stretch="Uniform"/>

            <TextBlock Text="{Binding FriendName}" Foreground="White" FontWeight="Bold" FontSize="12"
                       Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#88000000" Padding="6,2"/>

            <TextBlock Text="{Binding StatusText}" Foreground="#CCCCCC" FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" TextAlignment="Center"/>

            <Border Background="#99000000" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
                <TextBlock Text="{Binding StatsText}" Foreground="White" FontSize="10" FontFamily="Consolas"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                <Slider x:Name="SliderTabVolume" Width="60" Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="SliderTabVolume_ValueChanged"/>
                <Button Content="&#x2715;" Width="22" Height="22" Background="#CC2929" Foreground="White" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand" ToolTip="Desconectar"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
