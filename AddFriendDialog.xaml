<Window x:Class="RadminStreamApp.AddFriendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar Amigo" Height="200" Width="320"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#18181E" CornerRadius="8" BorderBrush="#2D2D35" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Adicionar Amigo" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="TxtIpLabel" Grid.Row="1" Text="IP: 127.0.0.1" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Apelido" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtNickname" Background="#1E1E24" Foreground="White" BorderBrush="#3D3D45" BorderThickness="1" Padding="6" Height="30" VerticalContentAlignment="Center" KeyDown="TxtNickname_KeyDown"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancelar" Width="80" Height="30" Margin="0,0,10,0" Background="#2D2D35" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Adicionar" Width="80" Height="30" Background="#0094F2" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnConfirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
