<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.26</Version>
    <!-- Version é a única fonte da verdade: AssemblyVersion, o texto na UI e o AppVersion
         do Inno Setup saem todos daqui (o build/version.iss é gerado no build). -->
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NU1903: SIPSorcery 8.0.23 tem dois advisories abertos (GHSA-28gm-jrmw-xx93 e
         GHSA-jwjp-4649-v8jp). A correção só existe na linha 10.x, que exige .NET 10 —
         migrar o projeto inteiro é o pré-requisito, e é um trabalho à parte.
         O aviso está silenciado de propósito, e não por descuido: repetido seis vezes em
         todo build, ele treinava a gente a ignorar a lista de avisos inteira.
         Ao migrar para .NET 10, remova esta linha. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <!-- Regras de captura que valem a pena testar sem serem API pública do app. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RadminStreamApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SIPSorcery" Version="8.0.23" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="8.0.7" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="8.0.7" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Websocket.Client" Version="5.5.0" />
  </ItemGroup>

  <!-- Bibliotecas nativas. O <Link> achata cada uma na raiz da saída: o P/Invoke da
       ApplicationLoopback e o FFmpeg carregam pelo nome, ao lado do executável. -->
  <ItemGroup>
    <None Update="NativeLibs\ApplicationLoopback.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <None Update="FFmpegLibs\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <Resource Include="Assets\app_icon.ico" />
  </ItemGroup>

  <!-- Mantém o instalador em sincronia com a versão do projeto (build/setup.iss dá #include nele). -->
  <Target Name="GenerateInnoSetupVersion" BeforeTargets="Build;Publish">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/../../build/version.iss"
                      Lines="#define AppVersion &quot;$(Version)&quot;"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
