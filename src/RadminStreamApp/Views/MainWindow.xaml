<Window x:Class="RadminStreamApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadminStreamApp"
        Title="Radmin Stream Live" Height="550" Width="900" MinHeight="420" MinWidth="620"
        Background="#0F0F13"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="/Assets/app_icon.ico">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D35"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Close Button Style -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D35"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D1D25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0094F2" Offset="0.0"/>
                        <GradientStop Color="#005A9E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0094F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#CC2929"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E53939"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A20"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- System Colors Override for Dark Mode (Fixes ComboBox dropdown and other popups) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E24" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E1E24" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        
        <!-- ComboBox Basic Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3D3D45"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <!-- Botões da barra de vídeo (estilo player: ícone limpo, indicador quando ativo) -->
        <Style x:Key="VideoBarToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="6"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="activeDot" Height="3" Width="18" CornerRadius="2" Background="#0094F2"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="activeDot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#4FB3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock Text="Radmin Stream Live" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnSettingsModal_Click" ToolTip="Configurações"/>
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click"/>
                <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Update Banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#CC2929" Margin="15,10,15,0" CornerRadius="8" Padding="10,5" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="UpdateBannerText" Text="Uma nova versão está disponível!" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnUpdate" Content="Atualizar Agora" Style="{StaticResource ModernButton}" Background="#1E1E24" Margin="0,0,10,0" Padding="10,2" Click="BtnUpdate_Click"/>
                    <Button x:Name="BtnDismissUpdate" Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDismissUpdate_Click" ToolTip="Ignorar por enquanto" Margin="0,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Panel (Controls) -->
        <Border x:Name="TopPanel" Grid.Row="2" Margin="15,10,15,15" Background="#18181E" CornerRadius="8" Padding="15">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Estado da sua transmissão: vive junto com as lives que você assiste -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                    <Border x:Name="LiveBadge" Background="#33E53935" BorderBrush="#E53935" BorderThickness="1"
                            CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF5252" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="AO VIVO" Foreground="#FF8A80" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tela:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboWindows" Width="130" Margin="0,0,10,0" DisplayMemberPath="Title"
                              VerticalAlignment="Center" Height="30"
                              DropDownOpened="CboWindows_DropDownOpened" SelectionChanged="CboWindows_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#1E1E24"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <Button x:Name="BtnStartStream" Content="Transmitir" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0" Click="BtnStartStream_Click"/>
                    <Button x:Name="BtnStopStream" Content="Parar" Style="{StaticResource DangerButton}"
                            Visibility="Collapsed" Margin="0,0,10,0" Click="BtnStopStream_Click"/>

                    <ToggleButton x:Name="BtnTogglePreview" Width="34" Height="30" Margin="0,0,10,0" Cursor="Hand"
                                  Background="#2D2D35" Foreground="#EEEEEE" BorderThickness="0" Visibility="Collapsed"
                                  Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Checked="BtnTogglePreview_Changed" Unchecked="BtnTogglePreview_Changed"
                                  ToolTip="Ver o que está sendo transmitido">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3D3D45"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#0094F2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <StackPanel x:Name="ViewerCountPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,10,0" Visibility="Collapsed"
                                Background="Transparent" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#0094F2" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="ViewerCountText" Text="0 assistindo" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>


                </StackPanel>

                <Border x:Name="ScreenOverlapWarning" Background="#33FFBB00" BorderBrush="#FFBB00" BorderThickness="1"
                        CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Visibility="Collapsed"
                        ToolTip="As lives que você assiste aparecem na sua transmissão. Mova a janela para outra tela ou escolha outra tela para transmitir.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#FFBB00" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Esta janela está na tela transmitida" Foreground="#FFD54F" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    </Border>

            </WrapPanel>
        </Border>

        <!-- Modo Assistir: sidebar de amigos + uma ou mais lives -->
        <Grid x:Name="ViewerArea" Grid.Row="3" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Área das lives -->
            <Grid Grid.Column="1">
                <Border Background="#050508" CornerRadius="12" BorderBrush="#2D2D35" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <StackPanel x:Name="ViewerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#2A2A32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ViewerEmptyText" Text="Clique em um amigo à esquerda para assistir"
                                       Foreground="#555560" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="GridSessions" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:StreamTab OnCloseRequested="StreamTab_OnCloseRequested"
                                                     OnActivated="StreamTab_OnActivated"
                                                     OnFocusRequested="StreamTab_OnFocusRequested"
                                                     OnRetryRequested="StreamTab_OnRetryRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TabControl x:Name="TabSessions" Background="Transparent" BorderThickness="0"
                                    Padding="0" SelectionChanged="TabSessions_SelectionChanged">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#14141A" CornerRadius="8,8,0,0" Padding="6,6,6,0"
                                                Visibility="{Binding DataContext.TabsHeaderVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0"/>
                                        </Border>
                                        <Border Grid.Row="1" Background="Transparent">
                                            <ContentPresenter ContentSource="SelectedContent"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Foreground" Value="#9A9AA4"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="tabBorder" Background="#1E1E24" CornerRadius="6,6,0,0"
                                                        Padding="12,7" Margin="0">
                                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tabBorder" Property="Background" Value="#26262E"/>
                                                        <Setter Property="Foreground" Value="#D8D8DE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="tabBorder" Property="Background" Value="#050508"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#00D26A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding FriendName}" VerticalAlignment="Center"/>
                                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="#8A8A94" BorderThickness="0"
                                                Cursor="Hand" Click="TabClose_Click" ToolTip="Sair desta live">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="closeBg" Background="{TemplateBinding Background}" CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="closeBg" Property="Background" Value="#CC2929"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <local:StreamTab OnCloseRequested="StreamTab_OnCloseRequested"
                                                     OnActivated="StreamTab_OnActivated"
                                                     OnFocusRequested="StreamTab_OnFocusRequested"
                                                     OnRetryRequested="StreamTab_OnRetryRequested"/>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                </Border>

                <!-- Botão da lista de amigos: fica sobre o vídeo e some junto com os controles -->
                <Border x:Name="SidebarHandle" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Panel.ZIndex="21" Opacity="0" IsHitTestVisible="False"
                        Background="#D91E1E24" BorderBrush="#4D4D57" BorderThickness="0,1,1,1"
                        CornerRadius="0,6,6,0" Padding="4,16" Cursor="Hand" ToolTip="Mostrar amigos"
                        MouseLeftButtonDown="SidebarHandle_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F22D2D35"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="SidebarHandleArrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="#D8D8DE" HorizontalAlignment="Center"/>
                </Border>

                        <!-- Controles do player: somem sozinhos e voltam quando o mouse passa -->
                        <Grid x:Name="VideoControlsBar" VerticalAlignment="Bottom"
                              Panel.ZIndex="20" Opacity="0" IsHitTestVisible="False">
                            <!-- Só os botões capturam o mouse; o gradiente é decorativo. -->
                            <Border x:Name="VideoControlsGradient" CornerRadius="0,0,12,12" IsHitTestVisible="False" Height="70"
                                    VerticalAlignment="Bottom">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.0"/>
                                        <GradientStop Color="#B3000000" Offset="0.6"/>
                                        <GradientStop Color="#E6000000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel x:Name="VideoControlsButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Margin="12,0,10,6">
                                <StackPanel x:Name="VolumeControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <ToggleButton x:Name="BtnMute" Style="{StaticResource VideoBarToggle}"
                                                  Content="{Binding ActiveSession.MuteIcon}"
                                                  Checked="BtnMute_Changed" Unchecked="BtnMute_Changed" ToolTip="Mudo"/>
                                    <Slider x:Name="SliderVolume" Width="76" Minimum="0" Maximum="200" VerticalAlignment="Center"
                                            Margin="2,0,6,0" Value="{Binding ActiveSession.Volume, Mode=TwoWay}" ToolTip="Volume"/>
                                </StackPanel>

                                <ToggleButton x:Name="ToggleStats" Style="{StaticResource VideoBarToggle}"
                                              Content="&#xE9D9;" Checked="ToggleStats_Changed" Unchecked="ToggleStats_Changed"
                                              ToolTip="Mostrar fps e latência"/>
                                <ToggleButton x:Name="ToggleFocus" Style="{StaticResource VideoBarToggle}"
                                              Content="&#xE8A7;" Checked="ToggleFocus_Changed" Unchecked="ToggleFocus_Changed"
                                              ToolTip="Focar só nesta live (as outras seguem conectadas)"/>
                                <ToggleButton x:Name="ToggleGridView" Style="{StaticResource VideoBarToggle}"
                                              Content="&#xE80A;" Checked="ToggleGridView_Changed" Unchecked="ToggleGridView_Changed"
                                              ToolTip="Ver em grade"/>
                                <ToggleButton x:Name="BtnPip" Style="{StaticResource VideoBarToggle}"
                                              Content="&#xEE49;" Checked="BtnPip_Changed" Unchecked="BtnPip_Changed"
                                              ToolTip="Picture-in-Picture"/>
                                <ToggleButton x:Name="BtnTheater" Style="{StaticResource VideoBarToggle}"
                                              Content="&#xE7F4;" Checked="BtnTheater_Changed" Unchecked="BtnTheater_Changed"
                                              ToolTip="Modo teatro"/>
                                <ToggleButton x:Name="BtnFullscreen" Style="{StaticResource VideoBarToggle}"
                                              Content="&#xE740;" Checked="BtnFullscreen_Changed" Unchecked="BtnFullscreen_Changed"
                                              ToolTip="Tela cheia"/>
                            </StackPanel>
                        </Grid>
            </Grid>

            <!-- Sidebar de amigos -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="#18181E" CornerRadius="8" Margin="0,0,4,0"
                    BorderBrush="#2D2D35" BorderThickness="1">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AMIGOS" Foreground="#666670" FontSize="11" FontWeight="Bold" Margin="4,0,0,8"/>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LstFriendsSidebar">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E24" CornerRadius="6" Margin="0,0,0,6" Padding="8,7"
                                                BorderThickness="1" BorderBrush="Transparent"
                                                MouseLeftButtonUp="FriendCard_Click" ToolTip="{Binding StatusTooltip}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Sem live para entrar, o card não é clicável: seta normal
                                                         e sem hit test, em vez de abrir uma conexão inútil. -->
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanWatch}" Value="True">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                            <Setter Property="Background" Value="#16324A"/>
                                                            <Setter Property="BorderBrush" Value="#0094F2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOnline}" Value="True"/>
                                                                <Condition Binding="{Binding IsStreaming}" Value="False"/>
                                                                <Condition Binding="{Binding IsWatching}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Opacity" Value="0.7"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" Fill="{Binding StatusColor}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SubtitleText}" Foreground="#8A8A94" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE768;"/>
                                                            <Setter Property="Foreground" Value="#0094F2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE71A;"/>
                                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CanWatch}" Value="False">
                                                                    <Setter Property="Text" Value=""/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="SidebarEmptyState" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Nenhum amigo adicionado ainda" Foreground="#666670" FontSize="12"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="4,0,4,10"/>
                            <Button Content="Adicionar amigo" Style="{StaticResource ModernButton}"
                                    Padding="8,6" FontSize="12" Click="BtnManageFriends_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="SidebarNoneOnline" Text="Nenhum amigo online no momento"
                                   Foreground="#666670" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Bottom" Margin="4,8,4,0" Visibility="Collapsed"/>
                    </Grid>

                    <Button Grid.Row="2" x:Name="BtnManageFriends" Content="Gerenciar amigos"
                            FontSize="12" Padding="8,6" Margin="0,8,0,0"
                            Style="{StaticResource ModernButton}" Click="BtnManageFriends_Click"/>
                </Grid>
            </Border>

            <!-- Aba visível que revela a sidebar de amigos quando ela está escondida -->
        </Grid>


        <!-- Preview do que você está transmitindo (opcional: você já vê a própria tela) -->
        <Border x:Name="HostPreviewCard" Grid.Row="3" Width="240" Height="150" Margin="0,10,25,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="30"
                Background="#050508" CornerRadius="8" ClipToBounds="True"
                BorderBrush="#E53935" BorderThickness="1" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.7" ShadowDepth="3"/>
            </Border.Effect>
            <Grid>
                <Image x:Name="VideoPlayer" Stretch="Uniform" MouseDown="VideoPlayer_MouseDown"/>
                <TextBlock x:Name="StatusText" Text="Sem sinal" Foreground="#3A3A42" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Border Background="#99000000" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="6">
                    <TextBlock Text="Sua transmissão" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                </Border>

                <Border x:Name="StatsOverlay" Background="#99000000" CornerRadius="3" Padding="5,2"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="StatsText" Text="" Foreground="White" FontSize="9" FontFamily="Consolas"/>
                </Border>

                <Button Content="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="20" Height="20"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                        Background="#99000000" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnClosePreview_Click" ToolTip="Fechar preview">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Floating Overlay for Mouse Activity -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="4" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
        </Grid>

        <!-- Settings Modal Overlay -->
        <Grid x:Name="SettingsModalOverlay" Grid.RowSpan="4" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#18181E" Width="450" Height="300" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="20,20,20,10">
                        <TextBlock Text="Configurações" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Foreground="#AAAAAA" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand" Click="BtnCloseSettingsModal_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                    <!-- Tabs -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0,10,10">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Name="Border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,0" Padding="5,5,5,10" Cursor="Hand">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#0094F2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        
                        <!-- Settings Tab -->
                        <TabItem Header="Settings" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="10,20,10,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkMaxPerformance" Content="Modo leve (usa menos CPU)" Foreground="White" FontSize="14" IsChecked="True" Checked="ChkMaxPerformance_Changed" Unchecked="ChkMaxPerformance_Changed"/>
                                    <TextBlock Foreground="#8A8A94" FontSize="11" Margin="26,4,0,0" TextWrapping="Wrap"
                                               Text="Codifica mais rápido, usa escala mais simples e cede prioridade de CPU aos outros programas. Desligue para uma imagem um pouco melhor, ao custo de mais CPU."/>
                                    <TextBlock Text="Ativar esta opção diminui a prioridade do aplicativo para garantir que seus jogos rodem com mais FPS, além de otimizar os cálculos da transmissão." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="20,5,0,0"/>

                                    <CheckBox x:Name="ChkFriendsOnly" Content="Aceitar conexões somente de amigos salvos" Foreground="White" FontSize="14" IsChecked="True" Margin="0,18,0,0" Checked="ChkFriendsOnly_Changed" Unchecked="ChkFriendsOnly_Changed"/>
                                    <TextBlock Text="Com esta opção desligada, qualquer máquina da VPN consegue entrar em uma live sem senha." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="20,5,0,0"/>

                                    <CheckBox x:Name="ChkForceGdiCapture" Content="Usar captura clássica de tela (GDI)" Foreground="White" FontSize="14" Margin="0,18,0,0" Checked="ChkForceGdiCapture_Changed" Unchecked="ChkForceGdiCapture_Changed"/>
                                    <TextBlock x:Name="CaptureModeText" Foreground="#8A8A94" FontSize="11" Margin="26,4,0,0"
                                               TextWrapping="Wrap" Text="Modo de captura: —"/>
                                    <TextBlock Text="Por padrão a tela é capturada pela Desktop Duplication (DXGI), mais leve. Marque esta opção se a transmissão ficar preta, travada ou com a imagem deslocada." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="20,5,0,0"/>

                                    <TextBlock Text="Excluir o áudio de um programa" Foreground="White" FontSize="14" Margin="0,18,0,0"/>
                                    <TextBlock Text="O áudio deste programa não entra na transmissão — útil para o app de chamada de voz, evitando que seus amigos ouçam a si mesmos." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                    <ComboBox x:Name="CboAudioExclusion" Height="30" FontSize="13"
                                              DropDownOpened="CboAudioExclusion_DropDownOpened"
                                              SelectionChanged="CboAudioExclusion_SelectionChanged"/>
                                    <TextBlock x:Name="AudioExclusionWarning" Foreground="#E8A33D" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        
                        <!-- Info Tab -->
                        <TabItem Header="Info" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="10,20,10,10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Radmin Stream Live" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="VersionText" Text="Versão" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                                    
                                    <TextBlock Foreground="#0094F2" FontSize="14" HorizontalAlignment="Center" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="GithubLink_Click">
                                        GitHub Repository
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
